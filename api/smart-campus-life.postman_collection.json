{
  "info": {
    "_postman_id": "8cce9cb4-e2b5-4c3e-8ac2-d3eb99f8ea68",
    "name": "智享校园生活服务平台 API（2026-07-31）",
    "description": "Postman Collection v2.1。默认直连后端 8082；先发送验证码并登录，登录请求会自动写入 collection variable token，手机号登录令牌采用 1 天滑动有效期。管理员接口需把管理员登录后的 token 填入 adminToken，商家管理接口需填入 merchantToken；商家角色不能直接设置，由管理员分配店铺归属时自动授予。校园助手接口要求登录：对话请求会自动保存并复用 agentConversationId，从可领券卡片保存一次性 agentActionToken，再由确认接口执行真实领券。Agent 自动评测接口要求管理员身份且仅在 AGENT_EVALUATION_ENABLED=true 时注册。注意：BlogCommentsController 当前没有任何已实现路由，因此未收录评论接口。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8082", "type": "string" },
    { "key": "phone", "value": "18722310795", "type": "string" },
    { "key": "code", "value": "123456", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "merchantToken", "value": "", "type": "string" },
    { "key": "userId", "value": "1", "type": "string" },
    { "key": "targetUserId", "value": "2", "type": "string" },
    { "key": "shopId", "value": "1", "type": "string" },
    { "key": "blogId", "value": "4", "type": "string" },
    { "key": "voucherId", "value": "1", "type": "string" },
    { "key": "ownerUserId", "value": "2", "type": "string" },
    { "key": "imageName", "value": "/blogs/0/0/example.png", "type": "string" },
    { "key": "agentConversationId", "value": "", "type": "string" },
    { "key": "agentActionToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01 用户认证与签到",
      "item": [
        { "name": "发送验证码", "request": { "method": "POST", "url": "{{baseUrl}}/user/code?phone={{phone}}" } },
        { "name": "登录（自动保存 token）", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.success && body.data) { pm.collectionVariables.set('token', body.data); }"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"code\": \"{{code}}\"\n}" }, "url": "{{baseUrl}}/user/login" } },
        { "name": "登出", "request": { "method": "POST", "header": [{ "key": "authorization", "value": "{{token}}" }], "url": "{{baseUrl}}/user/logout" } },
        { "name": "当前登录用户", "request": { "method": "GET", "header": [{ "key": "authorization", "value": "{{token}}" }], "url": "{{baseUrl}}/user/me" } },
        { "name": "查询用户详情", "request": { "method": "GET", "url": "{{baseUrl}}/user/info/{{userId}}" } },
        { "name": "按 ID 查询用户", "request": { "method": "GET", "url": "{{baseUrl}}/user/{{userId}}" } },
        { "name": "签到", "request": { "method": "POST", "header": [{ "key": "authorization", "value": "{{token}}" }], "url": "{{baseUrl}}/user/sign" } },
        { "name": "查询连续签到", "request": { "method": "GET", "header": [{ "key": "authorization", "value": "{{token}}" }], "url": "{{baseUrl}}/user/sign/count" } }
      ]
    },
    {
      "name": "02 公开店铺与分类",
      "item": [
        { "name": "查询店铺分类", "request": { "method": "GET", "url": "{{baseUrl}}/shop-type/list" } },
        { "name": "查询店铺详情", "request": { "method": "GET", "url": "{{baseUrl}}/shop/{{shopId}}" } },
        { "name": "按分类分页查询", "request": { "method": "GET", "url": "{{baseUrl}}/shop/of/type?typeId=1&current=1" } },
        { "name": "按坐标查询附近店铺", "request": { "method": "GET", "url": "{{baseUrl}}/shop/of/type?typeId=1&current=1&x=120.149993&y=30.334229" } },
        { "name": "按名称查询店铺", "request": { "method": "GET", "url": "{{baseUrl}}/shop/of/name?name=食堂&current=1" } },
        { "name": "查询店铺优惠券", "request": { "method": "GET", "url": "{{baseUrl}}/voucher/list/{{shopId}}" } }
      ]
    },
    {
      "name": "03 店铺管理（管理员/商家）",
      "item": [
        { "name": "查询我可管理的店铺", "request": { "method": "GET", "header": [{ "key": "authorization", "value": "{{merchantToken}}" }], "url": "{{baseUrl}}/shop/manage/mine" } },
        { "name": "商家修改自己的店铺", "request": { "method": "PUT", "header": [{ "key": "authorization", "value": "{{merchantToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"id\": {{shopId}},\n  \"name\": \"一食堂风味窗口\",\n  \"avgPrice\": 1600\n}" }, "url": "{{baseUrl}}/shop" } },
        { "name": "管理员新增店铺（自动保存 shopId）", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.success && body.data) { pm.collectionVariables.set('shopId', String(body.data)); }"] } }], "request": { "method": "POST", "header": [{ "key": "authorization", "value": "{{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"校园测试咖啡角\",\n  \"typeId\": 8,\n  \"images\": \"/imgs/campus/coffee-study.png\",\n  \"area\": \"图书馆一层\",\n  \"address\": \"图书馆一层东侧\",\n  \"x\": 120.149993,\n  \"y\": 30.334229,\n  \"avgPrice\": 18,\n  \"openHours\": \"08:00-22:00\"\n}" }, "url": "{{baseUrl}}/admin/shops" } },
        { "name": "管理员编辑店铺", "request": { "method": "PUT", "header": [{ "key": "authorization", "value": "{{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"校园测试咖啡角（更新）\",\n  \"typeId\": 8,\n  \"avgPrice\": 20\n}" }, "url": "{{baseUrl}}/admin/shops/{{shopId}}" } },
        { "name": "管理员分配店铺商家", "request": { "method": "PUT", "header": [{ "key": "authorization", "value": "{{adminToken}}" }], "url": "{{baseUrl}}/admin/shops/{{shopId}}/owner/{{ownerUserId}}" } },
        { "name": "管理员解除店铺商家", "request": { "method": "DELETE", "header": [{ "key": "authorization", "value": "{{adminToken}}" }], "url": "{{baseUrl}}/admin/shops/{{shopId}}/owner" } }
      ]
    },
    {
      "name": "04 优惠券管理（管理员/商家）",
      "item": [
        { "name": "新增普通券（自动保存 voucherId）", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.success && body.data) { pm.collectionVariables.set('voucherId', String(body.data)); }"] } }], "request": { "method": "POST", "header": [{ "key": "authorization", "value": "{{merchantToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"shopId\": {{shopId}},\n  \"title\": \"校园咖啡代金券\",\n  \"subTitle\": \"支付 8 元，抵扣 10 元\",\n  \"rules\": \"仅限到店核销\\n不兑现、不找零\",\n  \"payValue\": 800,\n  \"actualValue\": 1000\n}" }, "url": "{{baseUrl}}/voucher" } },
        { "name": "新增秒杀券（自动保存 voucherId）", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.success && body.data) { pm.collectionVariables.set('voucherId', String(body.data)); }"] } }], "request": { "method": "POST", "header": [{ "key": "authorization", "value": "{{merchantToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"shopId\": {{shopId}},\n  \"title\": \"校园餐饮秒杀券\",\n  \"subTitle\": \"支付 40 元，抵扣 50 元\",\n  \"rules\": \"每位同学限购一张\",\n  \"payValue\": 4000,\n  \"actualValue\": 5000,\n  \"stock\": 100,\n  \"beginTime\": \"2026-07-30T00:00:00\",\n  \"endTime\": \"2026-12-31T23:59:59\"\n}" }, "url": "{{baseUrl}}/voucher/seckill" } },
        { "name": "修改优惠券", "request": { "method": "PUT", "header": [{ "key": "authorization", "value": "{{merchantToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"校园餐饮代金券（更新）\",\n  \"subTitle\": \"支付 40 元，抵扣 50 元\",\n  \"payValue\": 4000,\n  \"actualValue\": 5000\n}" }, "url": "{{baseUrl}}/voucher/{{voucherId}}" } },
        { "name": "上架优惠券", "request": { "method": "PUT", "header": [{ "key": "authorization", "value": "{{merchantToken}}" }], "url": "{{baseUrl}}/voucher/{{voucherId}}/status/1" } },
        { "name": "下架优惠券", "request": { "method": "PUT", "header": [{ "key": "authorization", "value": "{{merchantToken}}" }], "url": "{{baseUrl}}/voucher/{{voucherId}}/status/2" } },
        { "name": "删除优惠券（无领取记录才允许）", "request": { "method": "DELETE", "header": [{ "key": "authorization", "value": "{{merchantToken}}" }], "url": "{{baseUrl}}/voucher/{{voucherId}}" } }
      ]
    },
    {
      "name": "05 领券与我的优惠券",
      "item": [
        { "name": "领取普通券", "request": { "method": "POST", "header": [{ "key": "authorization", "value": "{{token}}" }], "url": "{{baseUrl}}/voucher-order/receive/{{voucherId}}" } },
        { "name": "秒杀券下单", "request": { "method": "POST", "header": [{ "key": "authorization", "value": "{{token}}" }], "url": "{{baseUrl}}/voucher-order/seckill/{{voucherId}}" } },
        { "name": "查询我的优惠券", "request": { "method": "GET", "header": [{ "key": "authorization", "value": "{{token}}" }], "url": "{{baseUrl}}/voucher-order/my" } }
      ]
    },
    {
      "name": "06 校园助手（受控 Agent）",
      "item": [
        { "name": "找附近有券的晚餐店（创建会话）", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.success && body.data && body.data.conversationId) {", "  pm.collectionVariables.set('agentConversationId', body.data.conversationId);", "}"] } }], "request": { "method": "POST", "header": [{ "key": "authorization", "value": "{{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"message\": \"帮我找附近评分高、有券、适合两人晚餐的店。\",\n  \"x\": 120.149993,\n  \"y\": 30.334229\n}" }, "url": "{{baseUrl}}/agent/chat" } },
        { "name": "继续会话：查询可领券（自动保存确认凭证）", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.success && body.data && body.data.conversationId) {", "  pm.collectionVariables.set('agentConversationId', body.data.conversationId);", "}", "const cards = body && body.data && body.data.cards ? body.data.cards : [];", "const card = cards.find(item => item.actionToken);", "if (card) { pm.collectionVariables.set('agentActionToken', card.actionToken); }"] } }], "request": { "method": "POST", "header": [{ "key": "authorization", "value": "{{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"conversationId\": \"{{agentConversationId}}\",\n  \"message\": \"一食堂现在有什么券可以领？\"\n}" }, "url": "{{baseUrl}}/agent/chat" } },
        { "name": "确认 Agent 推荐的领券操作", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.success) { pm.collectionVariables.unset('agentActionToken'); }"] } }], "request": { "method": "POST", "header": [{ "key": "authorization", "value": "{{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"actionToken\": \"{{agentActionToken}}\"\n}" }, "url": "{{baseUrl}}/agent/actions/confirm" } },
        { "name": "继续会话：查询我的优惠券", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.success && body.data && body.data.conversationId) {", "  pm.collectionVariables.set('agentConversationId', body.data.conversationId);", "}"] } }], "request": { "method": "POST", "header": [{ "key": "authorization", "value": "{{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"conversationId\": \"{{agentConversationId}}\",\n  \"message\": \"我有哪些快到期的优惠券？\"\n}" }, "url": "{{baseUrl}}/agent/chat" } },
        { "name": "查看 Agent Golden Dataset（管理员）", "request": { "method": "GET", "header": [{ "key": "authorization", "value": "{{adminToken}}" }], "url": "{{baseUrl}}/admin/agent/evaluations/cases" } },
        { "name": "运行 Agent Smoke 自动评测（管理员）", "request": { "method": "POST", "header": [{ "key": "authorization", "value": "{{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"caseIds\": [],\n  \"levels\": [\"SMOKE\"],\n  \"categories\": [],\n  \"tags\": [],\n  \"repeat\": 1\n}" }, "url": "{{baseUrl}}/admin/agent/evaluations/run" } },
        { "name": "运行 Agent 安全评测（管理员）", "request": { "method": "POST", "header": [{ "key": "authorization", "value": "{{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"levels\": [\"SECURITY\"],\n  \"repeat\": 1\n}" }, "url": "{{baseUrl}}/admin/agent/evaluations/run" } },
        { "name": "按标签运行 Agent RAG 评测（管理员）", "request": { "method": "POST", "header": [{ "key": "authorization", "value": "{{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"tags\": [\"rag\"],\n  \"repeat\": 1\n}" }, "url": "{{baseUrl}}/admin/agent/evaluations/run" } }
      ]
    },
    {
      "name": "07 探店笔记",
      "item": [
        { "name": "发布笔记", "request": { "method": "POST", "header": [{ "key": "authorization", "value": "{{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"shopId\": {{shopId}},\n  \"title\": \"校园食堂午餐分享\",\n  \"images\": \"/imgs/campus/cafeteria-meal.png\",\n  \"content\": \"一食堂今天的烤肉饭很不错，出餐也很快。\"\n}" }, "url": "{{baseUrl}}/blog" } },
        { "name": "点赞或取消点赞", "request": { "method": "PUT", "header": [{ "key": "authorization", "value": "{{token}}" }], "url": "{{baseUrl}}/blog/like/{{blogId}}" } },
        { "name": "查询我的笔记", "request": { "method": "GET", "header": [{ "key": "authorization", "value": "{{token}}" }], "url": "{{baseUrl}}/blog/of/me?current=1" } },
        { "name": "查询热门笔记", "request": { "method": "GET", "url": "{{baseUrl}}/blog/hot?current=1" } },
        { "name": "查询笔记详情", "request": { "method": "GET", "url": "{{baseUrl}}/blog/{{blogId}}" } },
        { "name": "查询笔记点赞用户", "request": { "method": "GET", "url": "{{baseUrl}}/blog/likes/{{blogId}}" } },
        { "name": "按用户查询笔记", "request": { "method": "GET", "url": "{{baseUrl}}/blog/of/user?id={{userId}}&current=1" } },
        { "name": "查询关注用户的笔记", "request": { "method": "GET", "header": [{ "key": "authorization", "value": "{{token}}" }], "url": "{{baseUrl}}/blog/of/follow?lastId=9999999999999&offset=0" } }
      ]
    },
    {
      "name": "08 关注关系",
      "item": [
        { "name": "关注用户", "request": { "method": "PUT", "header": [{ "key": "authorization", "value": "{{token}}" }], "url": "{{baseUrl}}/follow/{{targetUserId}}/true" } },
        { "name": "取消关注", "request": { "method": "PUT", "header": [{ "key": "authorization", "value": "{{token}}" }], "url": "{{baseUrl}}/follow/{{targetUserId}}/false" } },
        { "name": "查询是否关注", "request": { "method": "GET", "header": [{ "key": "authorization", "value": "{{token}}" }], "url": "{{baseUrl}}/follow/or/not/{{targetUserId}}" } },
        { "name": "查询共同关注", "request": { "method": "GET", "header": [{ "key": "authorization", "value": "{{token}}" }], "url": "{{baseUrl}}/follow/common/{{targetUserId}}" } }
      ]
    },
    {
      "name": "09 图片上传",
      "item": [
        { "name": "上传笔记图片", "request": { "method": "POST", "header": [{ "key": "authorization", "value": "{{token}}" }], "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "", "description": "导入后选择本地图片" }] }, "url": "{{baseUrl}}/upload/blog" } },
        { "name": "删除笔记图片", "request": { "method": "GET", "url": "{{baseUrl}}/upload/blog/delete?name={{imageName}}" } }
      ]
    },
    {
      "name": "10 平台管理员：用户",
      "item": [
        { "name": "分页查询用户", "request": { "method": "GET", "header": [{ "key": "authorization", "value": "{{adminToken}}" }], "url": "{{baseUrl}}/admin/users?phone=&current=1" } },
        { "name": "设置用户为学生", "request": { "method": "PUT", "header": [{ "key": "authorization", "value": "{{adminToken}}" }], "url": "{{baseUrl}}/admin/users/{{targetUserId}}/role/0" } },
        { "name": "设置用户为管理员", "request": { "method": "PUT", "header": [{ "key": "authorization", "value": "{{adminToken}}" }], "url": "{{baseUrl}}/admin/users/{{targetUserId}}/role/1" } }
      ]
    }
  ]
}
